rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }
    function isAdmin() {
      return isSignedIn() && request.auth.token.admin == true;
    }

    // Master company list — visible to signed-in users. Writes only via Admin SDK.
    match /companies/{companyId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // Normalized jobs — visible to signed-in users, never client-writable.
    match /jobs/{jobId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // Per-user applied/not-applied state — owner only.
    match /users/{uid}/jobStatus/{jobId} {
      allow read, write: if isSignedIn() && request.auth.uid == uid;
    }

    // Per-user Discord notification subscriptions — owner only.
    match /users/{uid}/notificationSubscriptions/{subId} {
      allow read, write: if isSignedIn() && request.auth.uid == uid;
    }
  }
}
